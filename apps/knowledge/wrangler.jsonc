{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Knowledge Workspace example app (#167): an independent application that
  // integrates with ultra-easy through its public boundary only.
  "name": "ultra-easy-knowledge",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  // TanStack Start fetch handler. Weekly maintenance is registered with ultra-easy.
  "main": "./src/server.ts",
  "observability": {
    "enabled": true,
  },
  // Explicitly remove the interim weekly trigger from an already deployed Worker.
  "triggers": {
    "crons": [],
  },
  "vars": {
    // "auth0": trusted Auth0 session only (#182). "demo" (fixture principals) is
    // turned on by the local dev server alone (vite.config.ts), never deployed.
    "KNOWLEDGE_AUTH_MODE": "auth0",
    "AUTH0_DOMAIN": "dev-67c6cfj2y51bmeyf.us.auth0.com",
    "AUTH0_API_AUDIENCE": "https://ultra-easy/approval-api",
    // Single-organization staging tenant with public signup disabled (same as
    // approval-api). With Auth0 Organizations use AUTH0_ORGANIZATION_CLAIM_VALUE.
    "AUTH0_TENANT_IS_ORGANIZATION": "true",
    // Public ultra-easy API through the APPROVAL_API service binding (#183).
    "ULTRA_EASY_MODE": "remote",
    "KNOWLEDGE_ORGANIZATION_ID": "organization:staging",
    "APPROVAL_UI_BASE_URL": "https://ultra-easy.niboshi.workers.dev",
  },
  "services": [
    {
      "binding": "APPROVAL_API",
      "service": "ultra-easy-approval-api",
    },
  ],
  // Secrets (wrangler secret put, 1Password `ultra-easy`): SESSION_SECRET,
  // KNOWLEDGE_MCP_TOKEN, AUTH0_CLIENT_ID, AUTH0_CLIENT_SECRET (Auth0 Regular Web
  // Application; callback https://<host>/api/auth/callback, logout https://<host>/login).
  // AUTH0_AGENT_CLIENT_ID / AUTH0_AGENT_CLIENT_SECRET belong to a separate M2M Application.
  "d1_databases": [
    {
      // Knowledge-owned data (pages, revisions, snapshots, search, effects).
      "binding": "KNOWLEDGE_DB",
      "database_name": "ultra-easy-knowledge",
      "migrations_dir": "../../packages/knowledge-d1/migrations",
    },
    {
      // State of the ultra-easy stand-in (ActionRequests, runs, approvals,
      // authorization). Kept apart from Knowledge data on purpose.
      "binding": "ULTRA_EASY_MOCK_DB",
      "database_name": "ultra-easy-knowledge-mock-platform",
      "migrations_dir": "./ultra-easy-mock/migrations",
    },
  ],
}
