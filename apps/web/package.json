{
  "name": "@app/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*",
    "#components/*": "./src/components/*.tsx",
    "#lib/*": "./src/lib/*.ts",
    "#hooks/*": "./src/hooks/*.ts"
  },
  "scripts": {
    "dev": "vp dev --port 3000",
    "test": "vp test",
    "build": "vp build",
    "build:preview": "CLOUDFLARE_VITE_WRANGLER_CONFIG_PATH=./wrangler.preview.jsonc vp build",
    "preview": "vp preview",
    "generate-routes": "tsr generate",
    "deploy": "vp build && wrangler deploy",
    "deploy:preview": "CLOUDFLARE_VITE_WRANGLER_CONFIG_PATH=./wrangler.preview.jsonc vp build && wrangler versions upload"
  },
  "dependencies": {
    "@app/approval-application": "workspace:*",
    "@app/approval-core": "workspace:*",
    "@dagrejs/dagre": "^3.1.1",
    "@tanstack/react-router": "latest",
    "@tanstack/react-start": "latest",
    "@xyflow/react": "^12.11.6",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.47.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.26.0",
    "@cloudflare/workers-types": "^5.20260911.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-cli": "^1.132.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "wrangler": "^4.70.0"
  }
}
