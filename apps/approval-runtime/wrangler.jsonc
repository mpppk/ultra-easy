{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ultra-easy-approval-runtime-preview",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-15",
  "workers_dev": false,
  "d1_databases": [
    {
      "binding": "DB",
      "migrations_dir": "../../packages/approval-d1/migrations",
    },
  ],
  "vars": {
    "ACTION_EXECUTION_MODE": "execute",
    "OPENFGA_API_URL": "https://api.us1.fga.dev",
    "OPENFGA_STORE_ID": "01M31PMZ0DRBWZQ9D6TZ64E87W",
    "OPENFGA_AUTHORIZATION_MODEL_ID": "01M3C9612ARE2Q84RTT6QBFMSA",
    "OPENFGA_ASSUME_LIST_USERS_COMPLETE": "false",
    // #109: FGA alert用（tokenはsecret: ANALYTICS_ENGINE_API_TOKEN）。
    "ANALYTICS_ENGINE_ACCOUNT_ID": "e3e66e02919ba2916b412cba4009f5c0",
    "TELEMETRY_DATASET": "ultra_easy_telemetry_preview",
  },
  // #108: SLI / metricの時系列store（docs/observability.md「Time-series store」）。
  "analytics_engine_datasets": [
    {
      "binding": "TELEMETRY_ANALYTICS",
      "dataset": "ultra_easy_telemetry_preview",
    },
  ],
  "services": [
    {
      "binding": "ACTION_AUTHORIZER",
      "service": "ultra-easy-approval-runtime-preview",
      "entrypoint": "PreviewActionAuthorizer",
    },
    {
      "binding": "ACTION_EXECUTOR",
      "service": "ultra-easy-approval-runtime-preview",
      "entrypoint": "PreviewActionExecutor",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "NOTIFICATION_QUEUE",
        "queue": "ultra-easy-notifications-preview",
      },
    ],
    "consumers": [
      {
        "queue": "ultra-easy-notifications-preview",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "ultra-easy-notifications-preview-dlq",
      },
      {
        // #94: DLQに入った通知をoutbox deadへreconcileする（handleNotificationQueueBatch）。
        "queue": "ultra-easy-notifications-preview-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
      },
    ],
  },
  "triggers": {
    "crons": ["*/1 * * * *"],
  },
  "workflows": [
    {
      "binding": "ACTION_WORKFLOW",
      "name": "ultra-easy-action-workflow-preview",
      "class_name": "ActionWorkflow",
    },
  ],
}
