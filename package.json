{
  "name": "ultra-easy",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "tests"
  ],
  "type": "module",
  "scripts": {
    "dev": "vp run @app/web#dev",
    "build": "vp run -r build",
    "test": "vp run -r test",
    "deploy": "vp run @app/web#deploy",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@praha/byethrow-docs": "^0.12.0",
    "@praha/byethrow-oxlint": "^0.12.0",
    "@types/node": "^22.10.2",
    "oxlint-plugin-eslint": "^1.82.0",
    "typescript": "^7.0.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.1",
    "vite-plus": "0.3.1",
    "vitest": "4.1.11"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.1"
  },
  "packageManager": "bun@1.4.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss",
      "sharp",
      "workerd"
    ]
  }
