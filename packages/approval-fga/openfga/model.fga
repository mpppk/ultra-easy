model
  schema 1.1

# Source of truth for the ultra-easy OpenFGA authorization model.
# Changes go through PR -> CI (`fga model test`) -> publish (docs/runbooks/authorization-console.md).
# The console never writes models. Changes stay additive-only: existing
# relations are never removed or narrowed in place.
#
# Objects are tenant-scoped by the runtime (`tenantScopedOpenFgaObject`):
# ticket:<org>/<id>, authorization_admin:<org>/root, mcp_tool:<org>/<actionType>.

type user

type ticket
  relations
    define can_execute: [user]
    define can_approve: [user]

# Tenant-scoped console administration (M9). Membership is bootstrap-only
# (IaC / version-controlled), never mutated through the console.
type authorization_admin
  relations
    define editor: [user]
    define viewer: [user] or editor

# MCP Gateway Tool Exposure (M10). Which authority principals may see and call
# the MCP tool bound to an ActionType. Exposure is not execution permission:
# every tools/call still runs Full Action Authorization (ticket#can_execute ...).
type mcp_tool
  relations
    define can_use: [user]
