{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ultra-easy-approval-runtime-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-12",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ultra-easy-approval-runtime-test",
      "database_id": "00000000-0000-0000-0000-000000000001"
    }
  ],
  "vars": {
    "OPENFGA_API_URL": "http://127.0.0.1:8080",
    "OPENFGA_STORE_ID": "unused-for-direct-user-tests",
    "OPENFGA_AUTHORIZATION_MODEL_ID": "unused-for-direct-user-tests",
    "OPENFGA_ASSUME_LIST_USERS_COMPLETE": "false"
  },
  "workflows": [
    {
      "binding": "ACTION_WORKFLOW",
      "name": "ultra-easy-action-workflow",
      "class_name": "ActionWorkflow"
    }
  ]
}
