{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ultra-easy-approval-runtime-test",
  "main": "src/testing/test-worker.ts",
  "compatibility_date": "2026-09-12",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ultra-easy-approval-runtime-test",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "../approval-d1/migrations",
    },
  ],
  "vars": {
    "ACTION_EXECUTION_MODE": "execute",
    "OPENFGA_API_URL": "https://api.us1.fga.dev",
    "OPENFGA_STORE_ID": "01M31PMZ0DRBWZQ9D6TZ64E87W",
    "OPENFGA_AUTHORIZATION_MODEL_ID": "01M3C9612ARE2Q84RTT6QBFMSA",
    "OPENFGA_ASSUME_LIST_USERS_COMPLETE": "false",
  },
  // Workflow経路のexecutor registry（approval-apiのStagingActionExecutorに相当）。
  "services": [
    {
      "binding": "ACTION_EXECUTOR",
      "service": "ultra-easy-approval-runtime-test",
      "entrypoint": "TestActionExecutor",
    },
  ],
  "workflows": [
    {
      "binding": "ACTION_WORKFLOW",
      "name": "ultra-easy-action-workflow",
      "class_name": "ActionWorkflow",
    },
  ],
}
